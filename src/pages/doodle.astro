---
const isLocal =
  Astro.url.hostname === 'localhost' ||
  Astro.url.hostname === '127.0.0.1' ||
  Astro.url.hostname === '0.0.0.0' ||
  Astro.url.hostname.startsWith('192.168.') ||
  Astro.url.hostname.startsWith('10.');

if (!isLocal) {
  return Astro.redirect('/', 302);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dibuja la tarjeta base</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Georgia, serif;
        background: #10120f;
        color: #fff9e8;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100svh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background:
          radial-gradient(circle at 50% 36%, rgb(72 88 65 / 35%), transparent 45%),
          #10120f;
      }

      main {
        display: grid;
        justify-items: center;
        gap: 1rem;
        width: min(100%, 30rem);
      }

      p {
        max-width: 28rem;
        margin: 0;
        color: rgb(255 249 232 / 72%);
        line-height: 1.45;
        text-align: center;
      }

      .card {
        width: min(82vw, 23rem);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 28%;
        corner-shape: squircle;
        background: #fff9e8;
        box-shadow: 0 2rem 6rem rgb(0 0 0 / 45%);
      }

      canvas {
        display: block;
        width: 100%;
        height: 100%;
        cursor: crosshair;
        touch-action: none;
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      button {
        cursor: pointer;
        border: 0;
        padding: 0.7rem 1.25rem;
        font: inherit;
      }

      [data-clear] {
        background: transparent;
        color: #fff9e8;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      [data-save] {
        background: #ed8936;
        color: white;
      }

      [data-status] {
        min-height: 1.4em;
        font-size: 0.85rem;
      }

      @supports not (corner-shape: squircle) {
        .card {
          border-radius: 5.5rem;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p>
        Dibuja aquí la tarjeta base usando solamente negro. Cuando esté lista, pulsa
        “guardar dibujo”: se descargará como <strong>hero-doodle.json</strong>. Después avísame
        para incorporarla al hero.
      </p>
      <div class="card">
        <canvas width="768" height="768" data-canvas aria-label="Lienzo para el doodle"></canvas>
      </div>
      <div class="actions">
        <button type="button" data-clear>borrar</button>
        <button type="button" data-save>guardar dibujo</button>
      </div>
      <p data-status aria-live="polite"></p>
      <textarea data-output hidden readonly aria-label="Datos del doodle"></textarea>
    </main>

    <script is:inline>
      (() => {
        const canvas = document.querySelector('[data-canvas]');
        const clearButton = document.querySelector('[data-clear]');
        const saveButton = document.querySelector('[data-save]');
        const status = document.querySelector('[data-status]');
        const output = document.querySelector('[data-output]');
        if (!canvas || !clearButton || !saveButton || !status || !output) return;

        let strokes = [];
        let activeStroke = null;

        const pointFromEvent = (event) => {
          const rect = canvas.getBoundingClientRect();
          return [
            Math.round(((event.clientX - rect.left) / rect.width) * 2560) / 10,
            Math.round(((event.clientY - rect.top) / rect.height) * 2560) / 10,
          ];
        };

        const redraw = () => {
          const context = canvas.getContext('2d');
          if (!context) return;
          context.clearRect(0, 0, canvas.width, canvas.height);
          context.setTransform(canvas.width / 256, 0, 0, canvas.height / 256, 0, 0);
          context.strokeStyle = '#090909';
          context.lineWidth = 5.5;
          context.lineCap = 'round';
          context.lineJoin = 'round';

          for (const stroke of strokes) {
            if (stroke.length < 2) continue;
            context.beginPath();
            context.moveTo(stroke[0][0], stroke[0][1]);
            for (let index = 1; index < stroke.length; index += 1) {
              context.lineTo(stroke[index][0], stroke[index][1]);
            }
            context.stroke();
          }
        };

        canvas.addEventListener('pointerdown', (event) => {
          canvas.setPointerCapture(event.pointerId);
          activeStroke = [pointFromEvent(event)];
          strokes.push(activeStroke);
        });

        canvas.addEventListener('pointermove', (event) => {
          if (!activeStroke) return;
          const point = pointFromEvent(event);
          const previous = activeStroke[activeStroke.length - 1];
          if (Math.hypot(point[0] - previous[0], point[1] - previous[1]) < 1.8) return;
          activeStroke.push(point);
          redraw();
        });

        const finishStroke = () => {
          activeStroke = null;
        };
        canvas.addEventListener('pointerup', finishStroke);
        canvas.addEventListener('pointercancel', finishStroke);

        clearButton.addEventListener('click', () => {
          strokes = [];
          activeStroke = null;
          status.textContent = '';
          redraw();
        });

        saveButton.addEventListener('click', () => {
          const drawing = {
            strokes: strokes.filter((stroke) => stroke.length >= 2),
          };
          if (!drawing.strokes.length) {
            status.textContent = 'Dibuja algo primero.';
            return;
          }

          const serialized = JSON.stringify(drawing, null, 2);
          output.value = serialized;
          output.hidden = false;
          const blob = new Blob([serialized], { type: 'application/json' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = 'hero-doodle.json';
          link.click();
          URL.revokeObjectURL(link.href);
          status.textContent = 'Dibujo guardado. Ahora avísame.';
        });
      })();
    </script>
  </body>
</html>
