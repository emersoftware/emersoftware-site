{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emersoftware-site",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "dev": {
    "inspector_port": 0,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "GUESTBOOK_DB",
      "database_name": "emersoftware-guestbook",
      "database_id": "c8e334d1-77ad-448a-a10f-59896515df55",
      "migrations_dir": "migrations",
    },
  ],
}
